# Copy to .env (never committed) and fill in. Anything left blank runs on its mock.

# Where the estimator repo is checked out; the hub loads skill/forefront-estimate from it.
ESTIMATOR_DIR=C:\Games\Estimator
# One folder per job lives here: C:\Jobs\3226 Augustine\
JOBS_ROOT=C:\Jobs
# Python that has reportlab/pdfplumber (Setup Estimator.bat installs it). "py" on Windows.
PYTHON=py

# Claude. Blank = read ESTIMATOR_DIR\data\api_key.txt (the key saved in the Estimator app's Settings).
ANTHROPIC_API_KEY=
HUB_MODEL=claude-opus-5-5

# mock = everything on mocks (no credentials needed). live = use each connector whose settings are filled in.
HUB_MODE=live

# Homebase API key (Homebase > Settings > API keys; starts with hbk_). With a key the hub uses the API.
HOMEBASE_API_TOKEN=
HOMEBASE_URL=https://homebase.forefrontteam.com
# Who "mine" means in `hub jobs --mine` (estimator, PM or owner on the job)
HOMEBASE_ME=Hunter Patterson
# api (default with a key) | browser (Playwright with your login, fallback) | mock
HOMEBASE_DRIVER=

# Gmail: Google Cloud OAuth "Desktop app" client. Run `npm run hub -- gmail login` once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ADDRESS=hunter@forefrontteam.com

# CompanyCam access token (Bearer)
COMPANYCAM_TOKEN=

# Where your browser saves downloads; DocuSketch ESX files are picked up from here by project ID.
DOWNLOADS_DIR=
