# Copy to .env (never uploaded) and fill in. Anything left blank uses practice data or stays off.

# ---- You and your business (blank = the defaults shown)
HUB_OWNER_NAME=Marlys Woods
HUB_BUSINESS_NAME=Get In Tune
HUB_OWNER_EMAIL=marlys@getintunemusictherapy.com
# Mountain Time. Any IANA name works (America/Los_Angeles, Europe/Lisbon, ...).
HUB_TIME_ZONE=America/Denver
HUB_APP_NAME=Get In Tune Hub
# Where your day starts, for drive times to in-person appointments (e.g. your home address).
HUB_DAY_START_ADDRESS=

# mock = practice data everywhere (no accounts needed). live = use each connection whose settings are filled in.
HUB_MODE=live

# ---- The app's own agent: Google Gemini (free tier). Get a key at aistudio.google.com → Get API key.
# Blank = the agent is off, and the "Do this in Claude" buttons open your Claude app instead (no cost either way).
# On the free tier Google may use what's sent to improve its products: background features start off.
GEMINI_API_KEY=
# The main model (Ask, the daily brief) and the lighter one for routine work (email summaries, tasks from email).
HUB_MODEL=gemini-2.5-flash
HUB_FAST_MODEL=gemini-2.5-flash-lite
# The morning brief's time and days (0 = Sunday). It's switched on and off on the dashboard.
HUB_BRIEF_TIME=07:00
HUB_BRIEF_DAYS=1-5

# ---- Gmail and Google Calendar: your own Google Cloud "Desktop app" client. Double-click Connect Gmail to set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ADDRESS=getintunemusictherapy@gmail.com

# ---- Work email in Microsoft 365 (read-only). Double-click Connect Outlook to set up.
MS_CLIENT_ID=
MS_TENANT=
# The mailboxes to read: yours and the shared info@ box.
OUTLOOK_MAILBOXES=marlys@getintunemusictherapy.com,info@getintunemusictherapy.com

# ---- Motion (tasks): the API key from Motion → Settings → API. Blank = practice tasks.
MOTION_API_KEY=

# ---- Music (optional): your Spotify app's Client ID, set from the Music tab.
SPOTIFY_CLIENT_ID=
